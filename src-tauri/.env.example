# Neo4j Aura (Memory Engine + document vector search)
# For Victor MSI builds: values here are baked into the installer at compile time
# (see src-tauri/build.rs). Victor does not need a .env file on his machine.
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# Document embeddings use your OpenAI API key from STT settings (text-embedding-3-small, 1536 dims).
# Upload client docs in the Realtime panel; chunks are stored in Aura with a vector index.

# Google Calendar (optional — upcoming meetings → auto-fill client name)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Application type: Desktop (or Web with redirect below)
# Enable Google Calendar API for the project
# Authorized redirect URI: http://127.0.0.1:14528/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
